diff --git a/networking/udhcp/dhcpc.c b/networking/udhcp/dhcpc.c
index 7a4f319..2e8f9c4 100644
--- a/networking/udhcp/dhcpc.c
+++ b/networking/udhcp/dhcpc.c
@@ -50,0 +51,26 @@
+#if defined(SMALLOS)
+# include "uapi_syscall.h"
+
+static int smallos_syscall1(int num, unsigned int arg1)
+{
+	int ret;
+	__asm__ volatile("int $0x80"
+		: "=a"(ret)
+		: "a"(num), "b"(arg1)
+		: "memory");
+	return ret;
+}
+
+static int smallos_dhcp_configure(void)
+{
+	sys_net_op_request_t req;
+	memset(&req, 0, sizeof(req));
+	req.op = SYS_NET_OP_DHCP;
+	return smallos_syscall1(SYS_NET_OP, (unsigned int)&req);
+}
+
+static int smallos_udhcpc_interface_supported(const char *interface)
+{
+	return strcmp(interface, "eth0") == 0;
+}
+#endif
@@ -1328,0 +1355,13 @@
+
+#if defined(SMALLOS)
+	if (!smallos_udhcpc_interface_supported(client_data.interface)) {
+		bb_error_msg("SmallOS udhcpc supports eth0 only");
+		return 1;
+	}
+	if (smallos_dhcp_configure() > 0) {
+		bb_simple_info_msg("lease acquired via SmallOS DHCP");
+		return 0;
+	}
+	bb_simple_error_msg("no lease");
+	return 1;
+#endif
